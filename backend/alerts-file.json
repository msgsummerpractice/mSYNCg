{
    "id": "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/microsoft.insights/scheduledqueryrules/backend-error-rate-over-5",
    "name": "backend-error-rate-over-5",
    "type": "Microsoft.Insights/scheduledQueryRules",
    "location": "westeurope",
    "tags": {
        "SummerPractice": "Azure"
    },
    "kind": "LogAlert",
    "systemData": {
        "createdBy": "Sonia.Damian@msg.group",
        "createdByType": "User",
        "createdAt": "2026-08-26T11:24:17.0008714Z",
        "lastModifiedBy": "Sonia.Damian@msg.group",
        "lastModifiedByType": "User",
        "lastModifiedAt": "2026-08-26T11:24:17.0008714Z"
    },
    "properties": {
        "createdWithApiVersion": "2026-03-01",
        "displayName": "backend-error-rate-over-5",
        "description": "Triggers when backend 4xx and 5xx responses exceed 5% of total requests over a 5-minute window.",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "scopes": [
            "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/Microsoft.OperationalInsights/workspaces/workspacemsyncg9879"
        ],
        "targetResourceTypes": [
            "Microsoft.OperationalInsights/workspaces"
        ],
        "windowSize": "PT5M",
        "overrideQueryTimeRange": "P2D",
        "criteria": {
            "allOf": [
                {
                    "query": "ContainerAppConsoleLogs_CL\n| where TimeGenerated > ago(5m)\n| where ContainerAppName_s == \"msyncg-backend\"\n| where Log_s contains \"HTTP_REQUEST\"\n| extend StatusCode = toint(extract(@\"status=(\\d{3})\", 1, Log_s))\n| where isnotnull(StatusCode)\n| summarize\n    TotalRequests = count(),\n    ErrorRequests = countif(StatusCode >= 400 and StatusCode < 600)\n| extend ErrorRate =\n    100.0 * todouble(ErrorRequests) / todouble(TotalRequests)\n",
                    "timeAggregation": "Average",
                    "metricMeasureColumn": "ErrorRate",
                    "dimensions": [],
                    "operator": "GreaterThan",
                    "threshold": 5,
                    "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                    }
                }
            ]
        },
        "autoMitigate": false,
        "actions": {
            "actionGroups": [
                "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourcegroups/msyncg/providers/microsoft.insights/actiongroups/msyncg-alerts"
            ],
            "customProperties": {}
        }
    }
}
{
    "id": "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/microsoft.insights/scheduledqueryrules/backend-health-check-failed",
    "name": "backend-health-check-failed",
    "type": "Microsoft.Insights/scheduledQueryRules",
    "location": "westeurope",
    "tags": {
        "SummerPractice": "Azure"
    },
    "kind": "LogAlert",
    "systemData": {
        "createdBy": "Sonia.Damian@msg.group",
        "createdByType": "User",
        "createdAt": "2026-08-26T12:16:27.7477519Z",
        "lastModifiedBy": "Sonia.Damian@msg.group",
        "lastModifiedByType": "User",
        "lastModifiedAt": "2026-08-26T12:16:27.7477519Z"
    },
    "properties": {
        "createdWithApiVersion": "2026-03-01",
        "displayName": "backend-health-check-failed",
        "description": "Alert triggers when backend liveness or readiness health checks have no successful response for 5 consecutive minutes",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT1M",
        "scopes": [
            "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/Microsoft.OperationalInsights/workspaces/workspacemsyncg9879"
        ],
        "targetResourceTypes": [
            "Microsoft.OperationalInsights/workspaces"
        ],
        "windowSize": "PT5M",
        "overrideQueryTimeRange": "P2D",
        "criteria": {
            "allOf": [
                {
                    "query": "ContainerAppConsoleLogs_CL\n| where TimeGenerated > ago(5m)\n| where ContainerAppName_s == \"msyncg-backend\"\n| where Log_s contains \"HTTP_REQUEST\"\n| where Log_s contains \"/actuator/health/\"\n| extend\n    StatusCode = toint(extract(@\"status=(\\d{3})\", 1, Log_s)),\n    Path = extract(@\"path=([^ ]+)\", 1, Log_s)\n| summarize\n    LivenessSuccess = countif(\n        Path == \"/actuator/health/liveness\"\n        and StatusCode >= 200\n        and StatusCode < 400\n    ),\n    ReadinessSuccess = countif(\n        Path == \"/actuator/health/readiness\"\n        and StatusCode >= 200\n        and StatusCode < 400\n    )\n| extend HealthCheckFailed =\n    iff(LivenessSuccess == 0 or ReadinessSuccess == 0, 1, 0)\n",
                    "timeAggregation": "Maximum",
                    "metricMeasureColumn": "HealthCheckFailed",
                    "dimensions": [],
                    "operator": "GreaterThan",
                    "threshold": 0,
                    "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                    }
                }
            ]
        },
        "autoMitigate": false,
        "actions": {
            "actionGroups": [
                "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourcegroups/msyncg/providers/microsoft.insights/actiongroups/msyncg-alerts"
            ],
            "customProperties": {}
        }
    }
}
