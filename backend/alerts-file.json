    "id": "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/microsoft.insights/scheduledqueryrules/backend-p95-latency-over-1s",
    "name": "backend-p95-latency-over-1s",
    "type": "Microsoft.Insights/scheduledQueryRules",
    "location": "westeurope",
    "tags": {
        "SummerPractice": "Azure"
    },
    "kind": "LogAlert",
    "systemData": {
        "createdBy": "Sonia.Damian@msg.group",
        "createdByType": "User",
        "createdAt": "2026-08-26T11:27:46.254812Z",
        "lastModifiedBy": "Sonia.Damian@msg.group",
        "lastModifiedByType": "User",
        "lastModifiedAt": "2026-08-26T14:25:21.3098911Z"
    },
    "properties": {
        "createdWithApiVersion": "2026-03-01",
        "displayName": "backend-p95-latency-over-1s",
        "description": "Triggers when backend 95th percentile response latency exceeds 1 second over a 5-minute window.",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT1M",
        "scopes": [
            "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/mSYNCg/providers/Microsoft.OperationalInsights/workspaces/workspacemsyncg9879"
        ],
        "targetResourceTypes": [
            "Microsoft.OperationalInsights/workspaces"
        ],
        "windowSize": "PT1M",
        "overrideQueryTimeRange": "P2D",
        "criteria": {
            "allOf": [
                {
                    "query": "ContainerAppConsoleLogs_CL\n| where TimeGenerated > ago(5m)\n| where ContainerAppName_s == \"msyncg-backend\"\n| where Log_s contains \"HTTP_REQUEST\"\n| extend DurationMs = toint(extract(@\"durationMs=(\\d+)\", 1, Log_s))\n| where isnotnull(DurationMs)\n| summarize P95LatencyMs = percentile(DurationMs, 95)\n",
                    "timeAggregation": "Average",
                    "metricMeasureColumn": "P95LatencyMs",
                    "dimensions": [],
                    "operator": "GreaterThan",
                    "threshold": 1000,
                    "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                    }
                }
            ]
        },
        "autoMitigate": false,
        "actions": {
            "actionGroups": [
                "/subscriptions/BFF82F66-027A-4464-A242-3E971760BB2E/resourceGroups/mSYNCg/providers/microsoft.insights/actionGroups/msyncg-alerts"
            ],
            "customProperties": {}
        }
    }
}
